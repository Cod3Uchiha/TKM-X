# A fine-grained GitHub personal access token.
# Repository permission required: Actions = Read and write.
GITHUB_TOKEN=github_pat_replace_me

# Restricts the server to repositories owned by this account.
GITHUB_OWNER=Cod3Uchiha

# Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Use this value as either:
#   Authorization: Bearer <value>
# or in the private ChatGPT connector URL:
#   https://YOUR_PROJECT.vercel.app/api/mcp?key=<value>
MCP_ACCESS_KEY=replace_with_a_long_random_value
